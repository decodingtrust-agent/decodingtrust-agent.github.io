# /etc/decodingtrust-frontend.env  (chmod 600, owned by root)
#
# Loaded by decodingtrust-frontend.service. Edit and put real values
# server-side; do NOT commit the populated file to the repo.

# ---- Supabase (admin sign-in for /admin) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Misc ----
# Bind address (loopback only — nginx proxies in front).
HOSTNAME=127.0.0.1
PORT=3000
