# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
venv/
**/venv/
.venv/
**/.venv/
.venv-*/
**/.venv-*/

# Sibling worktrees / clones that live next to this repo
/DT-public-release/
/DecodingTrust-Agent/
/DecodingTrust-Agent-Platform/
*.egg-info/
/.pnp
.pnp.js

# testing
/coverage

# next.js
.next/
**/.next/
/out/
/frontend/out/

# Trajectory + dataset data — owned by the FastAPI service, served via
# /traj-api/*. Drop trajectory zips into ./trajectory/ and run:
#   cd frontend && npm run trajectories:unpack
/backend/data/
/backend/traj-api/.venv/
/trajectory/

# Per-deploy logs from the webhook handler
/var-log-dt-deploy/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
